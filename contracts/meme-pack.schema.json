{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin-meme-pack/v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "original",
    "source",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "kin-meme-pack/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "original": {
      "const": true
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "sha256",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,39}$"
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "ocr": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24
          },
          "ambiguity": {
            "type": "string",
            "maxLength": 600,
            "description": "Optional uncertainty; no interpretation is required."
          },
          "uses": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["when", "reading"],
              "additionalProperties": false,
              "properties": {
                "when": {"type": "string", "minLength": 1, "maxLength": 300},
                "reading": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          },
          "emotions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 24
          }
        }
      }
    }
  }
}
